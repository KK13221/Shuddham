NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/shuddham
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
# Comma-separated origins allowed to call the API (admin panel URL)
CORS_ORIGINS=http://localhost:5173

# MQTT broker for purifiers
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=shuddham/devices
# Enable MQTT over TLS (port 8883) in production:
MQTT_TLS_PORT=8883
MQTT_TLS_KEY=
MQTT_TLS_CERT=

# MSG91 OTP (leave empty in development: OTP is printed in the server log)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

DEVICE_OFFLINE_AFTER_SECONDS=120
MIN_READING_INTERVAL_SECONDS=10
DEFAULT_TDS_LIMIT=100
READING_RETENTION_DAYS=180
